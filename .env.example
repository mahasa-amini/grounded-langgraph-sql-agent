# Runtime
APP_ENV=development
GROUNDED_SQL_AGENT_DEBUG=false
AGENT_DEBUG=false
AGENT_DEBUG_MAX_CHARS=3000

# LLM Provider
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Default model (must already be installed locally)
DEFAULT_OLLAMA_MODEL=<installed-local-model>

# Role-specific models
INTERPRET_MODEL=<installed-local-model>
MAPPING_MODEL=<installed-local-model>
CLARIFICATION_MODEL=<installed-local-model>
# Retained for diagnostic compatibility; unused by normal deterministic SQL compilation.
SQL_MODEL=<unused-in-normal-compiler-path>
ANSWER_MODEL=<installed-local-model>

# Temperatures
INTERPRET_TEMPERATURE=0.0
MAPPING_TEMPERATURE=0.0
CLARIFICATION_TEMPERATURE=0.3
SQL_TEMPERATURE=0.0
ANSWER_TEMPERATURE=0.2

# Clarification loop
MAX_CLARIFICATION_COUNT=5

# BigQuery
# Replace these generic placeholders with identifiers for your Google Cloud environment.
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_ID=your_bigquery_dataset
BIGQUERY_TABLE_ID=your_bigquery_table
BIGQUERY_LOCATION=YOUR_BIGQUERY_LOCATION
BIGQUERY_LOGICAL_TABLE_NAME=sensor_measurements

# LangSmith tracing - optional for later
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=<optional-project-name>
